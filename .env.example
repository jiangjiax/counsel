# Choose one: ollama, deepseek, kimi, minimax, openai, dmx, laozhang
MODEL_PROVIDER=ollama
HOST=127.0.0.1
PORT=3000
STORAGE_ROOT=./sessions
SKILLS_DIR=./skills
COUNSEL_DB_URL=sqlite://./auth.db
